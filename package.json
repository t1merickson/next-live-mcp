{
  "name": "ableton-mcp-extension",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t1merickson/next-live-mcp.git"
  },
  "homepage": "https://github.com/t1merickson/next-live-mcp#readme",
  "bugs": {
    "url": "https://github.com/t1merickson/next-live-mcp/issues"
  },
  "bin": {
    "ableton-mcp": "dist/bridge.cjs"
  },
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:fake": "tsx src/dev/fake-server.ts",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:tools": "tsx scripts/gen-tools-md.ts",
    "setup:sdk": "npm install --no-save file:references/extensions-sdk-1.0.0-beta.1/ableton-extensions-sdk-1.0.0-beta.1.tgz file:references/extensions-sdk-1.0.0-beta.1/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "typecheck:sdk": "tsc --noEmit -p tsconfig.sdk.json",
    "build": "tsx build.ts",
    "build:dev": "tsx build.ts --dev",
    "start": "npm run build:dev && extensions-cli run .",
    "package": "npm run build && node scripts/package-ablx.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
